{
  "name": "devpath",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "npm run build -- --mode android && cap sync android && node scripts/android/configure-firebase.mjs",
    "test:firebase:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-devpath-sync \"node --test tests/firestore-rules.test.mjs\"",
    "preview": "vite preview --host 127.0.0.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "@fontsource/vazirmatn": "^5.2.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
